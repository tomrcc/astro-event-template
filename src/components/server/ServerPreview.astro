---
import { editorBuild } from '../../lib/editor-build';

interface Props {
	note?: string;
}
const { note } = Astro.props;
---
{editorBuild && (
	<span class="server-preview">
		<button type="button" class="server-preview-icon" aria-expanded="false" aria-label="About this preview">
			<svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
				<rect x="3" y="4" width="18" height="7" rx="2" /><rect x="3" y="13" width="18" height="7" rx="2" />
				<path d="M7 7.5h.01M7 16.5h.01" />
			</svg>
		</button>
		<span class="server-preview-note" role="tooltip">{note || 'Editor preview. On the live site, this part comes from the server.'}</span>
		{/* Inline so the badge's CSS and JS ship only in the editor build. */}
		{/* CloudCannon puts .cms-editor-active on <body> in the Visual Editor, so the badge stays hidden on the hosted static copy. */}
		<style is:inline>
			.cms-editor-active :has(> .server-preview) {
				position: relative;
				outline: 1px dashed rgb(124 58 237 / 0.45);
				outline-offset: 6px;
			}
			.server-preview {
				display: none;
			}
			.cms-editor-active .server-preview {
				display: block;
				position: absolute;
				top: -0.75rem;
				right: -0.75rem;
				z-index: 10;
				font: 0.8125rem/1.4 system-ui, sans-serif;
			}
			.server-preview-icon {
				display: grid;
				place-items: center;
				width: 1.75rem;
				height: 1.75rem;
				padding: 0;
				border: 0;
				border-radius: 50%;
				background: #7c3aed;
				color: #fff;
				cursor: help;
			}
			.server-preview-note {
				display: none;
				position: absolute;
				top: 2.25rem;
				right: 0;
				width: max-content;
				max-width: 16rem;
				padding: 0.5rem 0.75rem;
				border-radius: 0.375rem;
				background: #1f1235;
				color: #fff;
				text-align: left;
			}
			.server-preview:hover .server-preview-note,
			.server-preview-icon[aria-expanded='true'] + .server-preview-note {
				display: block;
			}
		</style>
		<script is:inline>
			(() => {
				const button = document.currentScript.parentElement.querySelector('.server-preview-icon');
				button.addEventListener('click', () => {
					button.setAttribute('aria-expanded', String(button.getAttribute('aria-expanded') !== 'true'));
				});
			})();
		</script>
	</span>
)}
